@model List<ClinicHub.Models.Content.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
    Layout = "_LayoutAdmin";
}

<!-- Success Message -->
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Contact messages</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Contact messages</h1>
        <p class="text-secondary mb-0">Read and manage messages sent to the clinic.</p>
    </div>
    <span class="badge text-bg-primary fs-6">@(Model?.Count ?? 0) total</span>
</div>

<!-- Contact Messages Table -->
<section class="card">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Inbox</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sender</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Received</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var messages in Model)
                    {
                        <tr>
                            <!-- Sender -->
                            <td>
                                <div class="fw-semibold">@messages.FullName</div>
                                <small class="text-secondary">@messages.Email</small>
                            </td>

                            <!-- Subject -->
                            <td>@messages.Subject</td>

                            <!-- Status -->
                            <td>
                                @if (messages.IsRead)
                                {
                                    <span class="badge text-bg-success">Read</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Unread</span>
                                }
                            </td>

                            <!-- Received -->
                            <td>@messages.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@messages.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteMessageModal-@messages.Id">
                                        Delete
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteMessageModal-@messages.Id" tabindex="-1"
                                     aria-labelledby="deleteMessageLabel-@messages.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="deleteMessageLabel-@messages.Id">Delete message</h2>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                Delete the message from
                                                <strong>@messages.FullName</strong>
                                                about
                                                “@messages.Subject”?
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" method="post">
                                                    <input type="hidden" name="id" value="@messages.Id" />
                                                    <button type="submit" class="btn btn-danger">Delete message</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Empty Inbox -->
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <h3 class="h5">Inbox is empty</h3>
                            <p class="text-secondary mb-0">No contact messages found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>