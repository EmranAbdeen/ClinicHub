@using ClinicHub.DTOs.Appointment
@using ClinicHub.Models.Enums
@model AppointmentListDto
@{
    ViewData["Title"] = "Appointment Details";
    Layout = "_LayoutAdmin";

    var badge = Model.Status switch
    {
        AppointmentStatus.Pending   => "text-bg-warning",
        AppointmentStatus.Confirmed => "text-bg-primary",
        AppointmentStatus.Completed => "text-bg-success",
        AppointmentStatus.Cancelled => "text-bg-danger",
        _                           => "text-bg-secondary"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="Index" class="text-decoration-none">Appointments</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Details</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Appointment details</h1>
        <p class="text-secondary mb-0">Booking information and current status.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to appointments</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit appointment</a>
    </div>
</div>

<section class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Appointment summary</h2>
        <span class="badge @badge">@Model.Status</span>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Patient</dt>
            <dd class="col-sm-9">@Model.PatientName</dd>

            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">Dr. @Model.DoctorName</dd>

            <dt class="col-sm-3">Specialty</dt>
            <dd class="col-sm-9">@Model.SpecialtyName</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd MMMM yyyy")</dd>

            <dt class="col-sm-3">Time</dt>
            <dd class="col-sm-9">@Model.AppointmentTime.ToString("HH:mm")</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</dd>
        </dl>
    </div>
</section>