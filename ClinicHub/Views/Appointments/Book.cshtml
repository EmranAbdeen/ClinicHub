@model ClinicHub.DTOs.Appointment.AppointmentCreateDto
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Book Appointment</h2>
            <p class="text-muted mb-0">Choose a doctor, date and available appointment time.</p>
        </div>
        <a asp-controller="Patients" asp-action="Profile" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Profile
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-calendar-plus me-2"></i>
                New Appointment
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="Book" method="post" id="bookingForm">
                <div class="row">

                    <!-- Doctor -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DoctorId" class="form-label">Doctor</label>
                        <select asp-for="DoctorId" class="form-select" id="doctorSelect">
                            <option value="">Select Doctor</option>
                            @foreach (var doctor in ViewBag.Doctors)
                            {
                                <option value="@doctor.Id">
                                    Dr. @doctor.Name
                                    @if (!string.IsNullOrEmpty(doctor.Specialty))
                                    {
                                        @: - @doctor.Specialty
                                    }
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <!-- Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentDate" class="form-label">Appointment Date</label>
                        <select asp-for="AppointmentDate" class="form-select" id="dateSelect" disabled>
                            <option value="">Select Doctor First</option>
                        </select>
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <!-- Time -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentTime" class="form-label">Available Time</label>
                        <select asp-for="AppointmentTime" class="form-select" id="timeSelect" disabled>
                            <option value="">Select Date First</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        <div id="timeMessage" class="form-text">
                            Select a doctor and date to see available times.
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Notes" class="form-label">Note</label>
                        <textarea asp-for="Notes" class="form-control" rows="4"
                                  placeholder="Write a note about your appointment..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Patients" asp-action="Profile" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary" id="bookButton" disabled>
                        <i class="bi bi-calendar-check me-1"></i>
                        Book Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/appointment.js"></script>