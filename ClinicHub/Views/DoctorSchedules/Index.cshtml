@model List<ClinicHub.DTOs.Doctor.DoctorProfile.DoctorScheduleDto>
@{
    ViewData["Title"] = "My Schedules";
    Layout = "_Layout";
}

<div class="container py-4">

    <!-- Alerts -->
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-@(TempData["SuccessType"] ?? "success") alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a asp-controller="Doctors" asp-action="Profile">Doctor profile</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Schedule</li>
                </ol>
            </nav>
            <h1 class="h3 mb-1">My schedule</h1>
            <p class="text-secondary mb-0">Manage available dates and appointment times.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Doctors" asp-action="Profile" class="btn btn-outline-secondary">Back to profile</a>
            <a asp-action="Create" class="btn btn-primary">Add schedule</a>
        </div>
    </div>

    <!-- Availability Table -->
    <section class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Availability</h2>
            <span class="badge text-bg-primary">@Model.Count</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Hours</th>
                        <th>Slot duration</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var schedule in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@schedule.AvailableDate.ToString("dd MMM yyyy")</td>
                                <td>@schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")</td>
                                <td>@schedule.SlotMinutes minutes</td>
                                <td>
                                    @if (schedule.IsAvailable)
                                    {
                                        <span class="badge text-bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Unavailable</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@schedule.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteSchedule-@schedule.Id">
                                            Delete
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteSchedule-@schedule.Id" tabindex="-1"
                                         aria-labelledby="deleteScheduleLabel-@schedule.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h2 class="modal-title h5" id="deleteScheduleLabel-@schedule.Id">Delete schedule</h2>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    Delete the schedule for
                                                    <strong>@schedule.AvailableDate.ToString("dd MMM yyyy")</strong>,
                                                    @schedule.StartTime.ToString("HH:mm")–@schedule.EndTime.ToString("HH:mm")?
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" method="post">
                                                        <input type="hidden" name="id" value="@schedule.Id" />
                                                        <button type="submit" class="btn btn-danger">Delete schedule</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <h3 class="h5">No schedules yet</h3>
                                <p class="text-secondary mb-3">Add your availability so patients can book appointments.</p>
                                <a asp-action="Create" class="btn btn-primary">Add schedule</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>