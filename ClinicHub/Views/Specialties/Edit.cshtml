@model ClinicHub.DTOs.Specialties.SpecialtyEditDto
@{
    ViewData["Title"] = "Edit Specialty";
    Layout = "_LayoutAdmin";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="Index" class="text-decoration-none">Specialties</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Edit specialty</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Edit specialty</h1>
        <p class="text-secondary mb-0">Update the name, description, or image.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to specialties</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post"
              enctype="multipart/form-data" class="card">
            <input asp-for="Id" type="hidden" />

            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Specialty information</h2>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Specialty name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Current Image -->
                @if (!string.IsNullOrEmpty(Model.IconOrImagePath))
                {
                    <div class="mb-3">
                        <label class="form-label">Current image</label>
                        <div>
                            <img src="@Model.IconOrImagePath" alt="@Model.Name" width="96" height="96"
                                 class="rounded object-fit-cover" />
                        </div>
                    </div>
                }

                <!-- Replace Image -->
                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Replace image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>