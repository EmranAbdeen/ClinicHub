@model List<ClinicHub.DTOs.Specialties.SpecialtyListDto>
@{
    ViewData["Title"] = "Specialties";
    Layout = "_LayoutAdmin";
}

<!-- Success Message -->
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Specialties</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Specialties</h1>
        <p class="text-secondary mb-0">Organize the clinic's medical departments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add specialty</a>
</div>

<!-- Search Section -->
<section class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label for="search" class="form-label">Search specialties</label>
                <input id="search" type="text" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Specialty name" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</a>
            </div>
        </form>
    </div>
</section>

<!-- Specialty Directory -->
<section class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Specialty directory</h2>
        <span class="badge text-bg-primary">@(Model?.Count ?? 0)</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Specialty</th>
                    <th>Description</th>
                    <th>Doctors</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var specialty in Model)
                    {
                        <tr>
                            <!-- Specialty -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(specialty.IconOrImagePath))
                                    {
                                        <img src="@specialty.IconOrImagePath" alt="" width="48" height="48"
                                             class="rounded object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">
                                            @(specialty.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                        </span>
                                    }
                                    <span class="fw-semibold">@specialty.Name</span>
                                </div>
                            </td>

                            <!-- Description -->
                            <td>
                                <div class="text-truncate" style="max-width: 300px;" title="@specialty.Description">
                                    @(string.IsNullOrWhiteSpace(specialty.Description) ? "—" : specialty.Description)
                                </div>
                            </td>

                            <!-- Doctors -->
                            <td><span class="badge text-bg-light">@specialty.DoctorCount</span></td>

                            <!-- Status -->
                            <td>
                                @if (specialty.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-1">
                                    <a asp-action="Details" asp-route-id="@specialty.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Details</a>
                                    <a asp-action="Edit" asp-route-id="@specialty.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
                                    <form asp-action="ToggleStatus" asp-route-id="@specialty.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-person-check me-1"></i> @(specialty.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteSpecialtyModal-@specialty.Id">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <h3 class="h5">No specialties found</h3>
                            <p class="text-secondary mb-3">Try another search or add a specialty.</p>
                            <a asp-action="Create" class="btn btn-primary">Add specialty</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete Specialty Modals -->
@if (Model?.Any() == true)
{
    foreach (var specialty in Model)
    {
        <div class="modal fade" id="deleteSpecialtyModal-@specialty.Id"
             tabindex="-1"
             aria-labelledby="deleteSpecialtyLabel-@specialty.Id"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteSpecialtyLabel-@specialty.Id">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body text-center">
                        @if (specialty.DoctorCount > 0)
                        {
                            <i class="bi bi-x-circle text-danger fs-1"></i>
                            <h5 class="mt-3">Cannot delete</h5>
                            <p class="text-muted mb-3">
                                This specialty cannot be deleted while doctors are assigned to it.
                            </p>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                            <h5 class="mt-3">Are you sure?</h5>
                            <p class="text-muted mb-3">
                                Are you sure you want to delete this specialty? This action cannot be undone.
                            </p>
                        }
                        <div class="fw-semibold">@specialty.Name</div>
                        <div class="text-muted">Doctors assigned: @specialty.DoctorCount</div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        @if (specialty.DoctorCount == 0)
                        {
                            <form asp-controller="Specialties" asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@specialty.Id" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash me-1"></i>Yes, Delete
                                </button>
                            </form>
                        }
                    </div>

                </div>
            </div>
        </div>
    }
}