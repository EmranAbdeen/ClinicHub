@model ClinicHub.Models.Content.WebsiteSetting

@{
    ViewData["Title"] = "Website Settings";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    @* Success message *@
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Website Settings</li>
        </ol>
    </nav>

    @* Page header *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Website Settings</h1>
            <p class="text-secondary mb-0">
                Manage clinic information and customize your website content.
            </p>
        </div>
    </div>

    @* Settings form *@
    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="row g-4">

            @* Clinic information *@
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white py-3">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-hospital me-2 text-primary"></i>
                            Clinic Information
                        </h2>
                    </div>

                    <div class="card-body p-4">

                        <div class="mb-3">
                            <label asp-for="ClinicName" class="form-label">Clinic Name</label>
                            <input asp-for="ClinicName" class="form-control" placeholder="Enter clinic name" />
                            <span asp-validation-for="ClinicName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" placeholder="Enter clinic address" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Email address" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div>
                            <label asp-for="WorkingHours" class="form-label">Working Hours</label>
                            <input asp-for="WorkingHours" class="form-control" placeholder="Sat–Thu, 9:00 AM–5:00 PM" />
                        </div>

                    </div>
                </section>
            </div>

            @* Homepage hero *@
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white py-3">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-window me-2 text-primary"></i>
                            Homepage Hero
                        </h2>
                    </div>

                    <div class="card-body p-4">

                        <div class="mb-3">
                            <label asp-for="HeroTitle" class="form-label">Hero Title</label>
                            <input asp-for="HeroTitle" class="form-control" placeholder="Enter homepage headline" />
                        </div>

                        <div>
                            <label asp-for="HeroText" class="form-label">Hero Text</label>
                            <textarea asp-for="HeroText"
                                      rows="5"
                                      class="form-control"
                                      placeholder="Enter introductory text shown on the homepage"></textarea>
                        </div>

                    </div>
                </section>
            </div>

            @* About the clinic *@
            <div class="col-12">
                <section class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-info-circle me-2 text-primary"></i>
                            About the Clinic
                        </h2>
                    </div>

                    <div class="card-body p-4">
                        <label asp-for="AboutText" class="form-label">About Text</label>
                        <textarea asp-for="AboutText"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Tell visitors about your clinic, services, and commitment to patient care"></textarea>
                    </div>

                </section>
            </div>

        </div>

        @* Form actions *@
        <div class="d-flex justify-content-end align-items-center gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i>
                Save Changes
            </button>
        </div>

    </form>

</div>