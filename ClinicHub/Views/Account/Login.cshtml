@using ClinicHub.DTOs.Account
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="container-fluid p-0 min-vh-100 d-flex flex-column">
    <div class="row g-0 flex-grow-1 min-vh-100">

        <div class="col-12 col-lg-6 col-xl-5 d-flex flex-column justify-content-center bg-white p-4 p-sm-5 min-vh-100">
            <div class="w-100 mx-auto" style="max-width: 420px;">

                <!-- ClinicHub Brand -->
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">
                        Clinic<span class="text-primary">Hub</span>
                    </h2>
                    <p class="text-muted mb-0">Welcome back! Please enter your details to log in.</p>
                </div>

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <div>@error</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <div>@success</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                <form asp-controller="Account" asp-action="Login" method="post" >
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" type="email" placeholder="name@example.com"
                                class="form-control form-control-lg bg-light border-start-0 fs-6"
                                    />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" id="passwordInput" placeholder="Enter your password" data-rr-is-password="true"
                                   class="form-control form-control-lg bg-light border-start-0 fs-6" />
                            <button type="button" id="togglePassword" class="input-group-text bg-light border-start-0 text-muted" tabindex="-1">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log In
                        </button>
                    </div>

                    <div class="text-center mt-4 pt-2 border-top">
                        <p class="text-muted mb-0 small">
                            Don't have an account?
                            <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">
                                Create an account
                            </a>
                        </p>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-controller="Home" asp-action="Index" class="text-secondary small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Back to ClinicHub home
                        </a>
                    </div>

                </form>

            </div>
        </div>

        <!-- Image / Branding Column -->
        <div class="col-lg-6 col-xl-7 d-none d-lg-block position-relative p-0 overflow-hidden">
            <img src="~/assetsAccount/images/staff-3.jpg" alt="Clinic Staff" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0" />
            <div class="position-absolute top-0 start-0 w-100 h-100 auth-hero-overlay d-flex flex-column justify-content-between p-5 text-white">
                <div class="d-flex align-items-center">
                    <span class="badge bg-white bg-opacity-25 px-3 py-2 rounded-pill fs-6 fw-normal text-white border border-white border-opacity-25">
                        <i class="bi bi-hospital me-1"></i> ClinicHub Healthcare System
                    </span>
                </div>
                <div class="mb-4">
                    <h1 class="display-6 fw-bold mb-3">Your Health, Seamlessly Managed.</h1>
                    <p class="lead opacity-90 mb-4 fs-6">
                        Empowering healthcare professionals and patients with seamless scheduling, digital clinical records, and personalized medical care.
                    </p>
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-25">
                                <h4 class="fw-bold mb-0">24/7</h4>
                                <small class="opacity-75">Care Access</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-25">
                                <h4 class="fw-bold mb-0">Verified</h4>
                                <small class="opacity-75">Specialists</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-25">
                                <h4 class="fw-bold mb-0">100%</h4>
                                <small class="opacity-75">Data Privacy</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const passwordInput = document.getElementById("passwordInput");
    const toggleBtn = document.getElementById("togglePassword");
    const toggleIcon = document.getElementById("togglePasswordIcon");

    toggleBtn.addEventListener("click", function () {
        const isHidden = passwordInput.type === "password";
        passwordInput.type = isHidden ? "text" : "password";
        toggleIcon.className = isHidden ? "bi bi-eye-slash" : "bi bi-eye";
    });
</script>
