@model List<ClinicHub.Models.Content.Service>
@{
    ViewData["Title"] = "Services";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Services</li>
                </ol>
            </nav>
            <h1 class="h3 mb-1">Services</h1>
            <p class="text-secondary mb-0">Manage the services displayed on the clinic website.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add service</a>
    </div>

    <!-- Service Directory -->
    <section class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Service directory</h2>
            <span class="badge text-bg-primary">@(Model?.Count ?? 0)</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Service</th>
                        <th>Description</th>
                        <th>Icon</th>
                        <th>Display order</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() == true)
                    {
                        foreach (var service in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@service.Title</td>

                                <td>
                                    <div class="text-truncate" style="max-width: 300px;" title="@service.Description">
                                        @(string.IsNullOrWhiteSpace(service.Description) ? "—" : service.Description)
                                    </div>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(service.IconOrImagePath))
                                    {
                                        <span>—</span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2">
                                            <i class="bi @service.IconOrImagePath fs-5"></i>
                                            <small class="text-secondary">@service.IconOrImagePath</small>
                                        </span>
                                    }
                                </td>

                                <td><span class="badge text-bg-light">@service.DisplayOrder</span></td>

                                <td>
                                    <div class="d-flex justify-content-end flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                        <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteServiceModal-@service.Id">
                                            Delete
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteServiceModal-@service.Id" tabindex="-1"
                                         aria-labelledby="deleteServiceLabel-@service.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h2 class="modal-title h5" id="deleteServiceLabel-@service.Id">Delete service</h2>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    Delete <strong>@service.Title</strong>? This action cannot be undone.
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" method="post">
                                                        <input type="hidden" name="id" value="@service.Id" />
                                                        <button type="submit" class="btn btn-danger">Delete service</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <h3 class="h5">No services found</h3>
                                <p class="text-secondary mb-3">Add a service to display it on the website.</p>
                                <a asp-action="Create" class="btn btn-primary">Add service</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>