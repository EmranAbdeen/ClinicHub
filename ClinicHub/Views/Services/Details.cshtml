@model ClinicHub.Models.Content.Service
@{
    ViewData["Title"] = "Service Details";
    Layout = "_Layout";
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none">Services</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Details</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Service details</h1>
            <p class="text-secondary mb-0">Information displayed on the clinic website.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Back to services</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit service</a>
        </div>
    </div>

    <section class="card">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">@Model.Title</h2>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </dd>

                <dt class="col-sm-3">Icon</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.IconOrImagePath))
                    {
                        <span class="d-inline-flex align-items-center gap-2">
                            <i class="bi @Model.IconOrImagePath fs-4"></i>
                            @Model.IconOrImagePath
                        </span>
                    }
                    else
                    {
                        <span>Not selected</span>
                    }
                </dd>

                <dt class="col-sm-3">Display order</dt>
                <dd class="col-sm-9">@Model.DisplayOrder</dd>
            </dl>
        </div>
    </section>

</div>