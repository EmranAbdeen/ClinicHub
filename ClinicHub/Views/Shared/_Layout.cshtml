@using ClinicHub.Models
@using Microsoft.EntityFrameworkCore
@inject ClinicDbContext Db
@{
    var settings = await Db.WebsiteSettings.FirstOrDefaultAsync();
    var footerServices = await Db.Services.OrderBy(s => s.DisplayOrder).Take(5).ToListAsync();
    var clinicName = settings?.ClinicName ?? "ClinicHub";
    var clinicPhone = settings?.Phone ?? "+1 5589 55488 55";
    var clinicEmail = settings?.Email ?? "info@example.com";
    var clinicAddress = settings?.Address ?? "A108 Adam Street, New York, NY 535022";
    var clinicAbout = settings?.AboutText ?? "We provide quality healthcare services with high standards of professionalism and ethics.";

    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - @clinicName</title>
    <meta name="description" content="@(settings?.HeroText ?? "")">
    <meta name="keywords" content="clinic, hospital, doctors, appointments, healthcare">

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/assets/css/main.css" rel="stylesheet">
</head>

<body class="index-page">

    <header id="header" class="header sticky-top bg-primary bg-opacity-25">

        <div class="branding d-flex align-items-center">

            <div class="container position-relative d-flex align-items-center justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto">
                    <h1 class="sitename">@clinicName</h1>
                </a>

                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")#hero">Home</a></li>
                        <li><a href="@Url.Action("Index", "Home")#about">About</a></li>
                        <li><a href="@Url.Action("Index", "Home")#services">Services</a></li>
                        <li><a href="@Url.Action("Index", "Home")#departments">Departments</a></li>
                        <li><a href="@Url.Action("Index", "Home")#doctors">Doctors</a></li>
                        <li><a href="@Url.Action("Index", "Home")#contact">Contact</a></li>

                        @if (userRole == "Admin" || userRole == "Super_admin")
                        {
                            <li><a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        }
                        else if (userRole == "Doctor")
                        {
                            <li class="dropdown">
                                <a href="#"><span>Doctor Portal</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                <ul>
                                    <li><a asp-controller="Doctors" asp-action="Profile"><i class="bi bi-person me-1"></i> My Profile</a></li>
                                    <li><a asp-controller="DoctorSchedules" asp-action="Index"><i class="bi bi-clock me-1"></i> My Schedules</a></li>
                                </ul>
                            </li>
                        }
                        else if (userRole == "Patient")
                        {
                            <li><a asp-controller="Patients" asp-action="Profile"><i class="bi bi-person me-1"></i> My Profile</a></li>
                        }
                    </ul>
                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                </nav>

                <div class="d-flex align-items-center ms-3">
                    @if (userRole == "Patient" || string.IsNullOrEmpty(userRole))
                    {
                        <a class="cta-btn d-none d-sm-block me-2" asp-controller="Appointments" asp-action="Book">Make an Appointment</a>
                    }

                    @if (userId != null)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-primary btn-sm dropdown-toggle rounded-pill px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> @userName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <span class="dropdown-item-text text-muted small">
                                        <i class="bi bi-shield-check me-2 text-primary"></i>
                                        <strong>@userRole</strong>
                                    </span>
                                </li>

                                <li><hr class="dropdown-divider"></li>
                                @if (userRole == "Admin" || userRole == "Super_admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                }
                                else if (userRole == "Doctor")
                                {
                                    <li><a class="dropdown-item" asp-controller="Doctors" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="DoctorSchedules" asp-action="Index"><i class="bi bi-clock me-2"></i>My Schedules</a></li>
                                }
                                else if (userRole == "Patient")
                                {
                                    <li><a class="dropdown-item" asp-controller="Patients" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Appointments" asp-action="Book"><i class="bi bi-calendar-plus me-2"></i>Book Appointment</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 ms-2" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                        <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 ms-1 d-none d-md-inline-block" asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    }
                </div>

            </div>

        </div>

    </header>

    @RenderBody()

    <footer id="footer" class="footer light-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                        <span class="sitename">@clinicName</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>@clinicAddress</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>@clinicPhone</span></p>
                        <p><strong>Email:</strong> <span>@clinicEmail</span></p>
                        @if (!string.IsNullOrEmpty(settings?.WorkingHours))
                        {
                            <p class="mt-2"><strong>Hours:</strong> <span>@settings.WorkingHours</span></p>
                        }
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")#hero">Home</a></li>
                        <li><a href="@Url.Action("Index", "Home")#about">About Us</a></li>
                        <li><a href="@Url.Action("Index", "Home")#services">Services</a></li>
                        <li><a href="@Url.Action("Index", "Home")#departments">Departments</a></li>
                        <li><a href="@Url.Action("Index", "Home")#doctors">Doctors</a></li>
                        <li><a asp-controller="Appointments" asp-action="Book">Book Appointment</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-3 footer-links">
                    <h4>Our Services</h4>
                    <ul>
                        @if (footerServices.Any())
                        {
                            @foreach (var s in footerServices)
                            {
                                <li><a href="@Url.Action("Index", "Home")#services">@s.Title</a></li>
                            }
                        }
                        else
                        {
                            <li><a href="@Url.Action("Index", "Home")#services">Cardiology</a></li>
                            <li><a href="@Url.Action("Index", "Home")#services">Neurology</a></li>
                            <li><a href="@Url.Action("Index", "Home")#services">Pediatrics</a></li>
                            <li><a href="@Url.Action("Index", "Home")#services">Eye Care</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 footer-links">
                    <h4>About Clinic</h4>
                    <p class="text-muted small">@clinicAbout</p>
                </div>

            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>@DateTime.Now.Year</span> <strong class="px-1 sitename">@clinicName</strong> <span>All Rights Reserved</span></p>
        </div>

    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
