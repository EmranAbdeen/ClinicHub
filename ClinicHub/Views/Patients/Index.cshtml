@using ClinicHub.DTOs.Patient
@model List<PatientListDto>
@{
    ViewData["Title"] = "Patients";
    Layout = "_LayoutAdmin";
}

<!-- Success Message -->
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Patients</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Patients</h1>
        <p class="text-secondary mb-0">Manage patient accounts and information.</p>
    </div>
</div>

<!-- Search Section -->
<section class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label for="search" class="form-label">Search Patients</label>
                <input type="text" id="search" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Search by name, email, or phone" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>
                    Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset
                </a>
            </div>
        </form>
    </div>
</section>

<!-- Patients Table -->
<section class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0">Patient Directory</h2>
        <span class="badge text-bg-primary">@(Model?.Count ?? 0)</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Patient</th>
                    <th>Contact</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var patient in Model)
                    {
                        <tr>
                            <!-- Patient Information -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(patient.ImagePath))
                                    {
                                        <img src="@patient.ImagePath" alt="@patient.FullName"
                                             width="48" height="48" class="rounded-circle object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                              style="width: 48px; height: 48px;">
                                            @(patient.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                        </span>
                                    }
                                    <span class="fw-semibold">@patient.FullName</span>
                                </div>
                            </td>

                            <!-- Contact Information -->
                            <td>
                                <div>@patient.Email</div>
                                <small class="text-secondary">@(patient.Phone ?? "—")</small>
                            </td>

                            <!-- Date of Birth -->
                            <td>
                                @(patient.DateOfBirth.HasValue
                                    ? patient.DateOfBirth.Value.ToString("dd MMM yyyy")
                                    : "—")
                            </td>

                            <!-- Gender -->
                            <td>@(string.IsNullOrWhiteSpace(patient.Gender) ? "—" : patient.Gender)</td>

                            <!-- Account Status -->
                            <td>
                                @if (patient.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>

                                    <form asp-action="ToggleStatus" asp-route-id="@patient.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-person-check me-1"></i>
                                            @(patient.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deletePatientModal-@patient.Id">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Empty State -->
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-people text-secondary fs-1 d-block mb-3"></i>
                            <h3 class="h5">No Patients Found</h3>
                            <p class="text-secondary mb-0">Try adjusting your search terms.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Table Footer -->
    <div class="card-footer bg-white text-secondary small">
        Showing @(Model?.Count ?? 0) patient(s)
    </div>
</section>

<!-- Delete Confirmation Modals -->
@if (Model?.Any() == true)
{
    foreach (var patient in Model)
    {
        <div class="modal fade" id="deletePatientModal-@patient.Id"
             tabindex="-1"
             aria-labelledby="deletePatientLabel-@patient.Id"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="deletePatientLabel-@patient.Id">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body text-center">
                        <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                        <h5 class="mt-3">Are you sure?</h5>
                        <p class="text-muted mb-3">
                            Are you sure you want to permanently delete this patient? This action cannot be undone.
                        </p>
                        <div class="fw-semibold">@patient.FullName</div>
                        <div class="text-muted">@patient.Email</div>
                        <div class="text-muted">@(string.IsNullOrWhiteSpace(patient.Phone) ? "—" : patient.Phone)</div>
                        <div class="small text-secondary mt-3">
                            Patients with linked appointments cannot be deleted.
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form asp-controller="Patients" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@patient.Id" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Yes, Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}