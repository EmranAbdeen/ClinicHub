@using ClinicHub.Models.Enums
@model ClinicHub.DTOs.Patient.PatientProfileDto
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Profile</h1>
            <p class="text-muted mb-0">Manage your personal information, appointments, messages and testimonials</p>
        </div>
        <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i>
            Book Appointment
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-1"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Personal Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-person-circle me-2"></i>
                Personal Information
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                <div class="row g-4">

                    <!-- Profile Image -->
                    <div class="col-md-3 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" width="170" height="170"
                                 class="rounded-circle img-thumbnail object-fit-cover mb-3" alt="Patient Image" />
                        }
                        else
                        {
                            <span class="badge rounded-circle text-bg-primary fs-1 p-4 mb-3">@Model.FullName?.FirstOrDefault()</span>
                        }
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                    </div>

                    <!-- Information -->
                    <div class="col-md-9">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name</label>
                                <input type="text" name="FullName" value="@Model.FullName" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="Email" value="@Model.Email" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone</label>
                                <input type="text" name="Phone" value="@Model.Phone" maxlength="10" class="form-control" />
                                <small class="text-muted">Must start with 07 and contain 10 digits.</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date of Birth</label>
                                <input type="date" name="DateOfBirth"
                                       value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Gender</label>
                                <select name="Gender" class="form-select">
                                    <option value="">Select Gender</option>

                                    @if (Model.Gender == "Male")
                                    {
                                        <option value="Male" selected>Male</option>
                                    }
                                    else
                                    {
                                        <option value="Male">Male</option>
                                    }

                                    @if (Model.Gender == "Female")
                                    {
                                        <option value="Female" selected>Female</option>
                                    }
                                    else
                                    {
                                        <option value="Female">Female</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Account Status</label>
                                <div class="form-control bg-light">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </div>
                            </div>

                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Save Changes
                            </button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Appointments -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-calendar-check me-2"></i>
                My Appointments
            </h5>
            <span class="badge bg-primary">@(Model.Appointments?.Count ?? 0)</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Doctor</th>
                                <th>Specialty</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Note</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                var status = (AppointmentStatus)appointment.Status;

                                <tr>
                                    <td><span class="fw-semibold">Dr. @appointment.DoctorName</span></td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(appointment.SpecialtyName))
                                        {
                                            @appointment.SpecialtyName
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>

                                    <td>
                                        <i class="bi bi-clock me-1 text-muted"></i>
                                        @appointment.AppointmentTime.ToString("hh:mm tt")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                        {
                                            <span title="@appointment.Notes">@appointment.Notes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">
                                        @if (status == AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (status == AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-primary">Confirmed</span>
                                        }
                                        else if (status == AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else if (status == AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else if (status == AppointmentStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>

                                    <!-- Action -->
                                    <td class="text-center">
                                        @if (status == AppointmentStatus.Pending)
                                        {
                                            <div class="d-flex justify-content-center gap-2">

                                                <!-- Edit -->
                                                <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-sm btn-warning">
                                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                                </a>

                                                <!-- Cancel -->
                                                <form asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                    <input type="hidden" name="status" value="@((int)AppointmentStatus.Cancelled)" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Patients")" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Cancel
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (status == AppointmentStatus.Confirmed)
                                        {
                                            <form asp-controller="Appointments"  asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="status" value="@((int)AppointmentStatus.Cancelled)" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Patients")" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <h5 class="mt-3">No Appointments</h5>
                    <p class="text-muted">You don't have any appointments yet.</p>
                    <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary">
                        <i class="bi bi-calendar-plus me-1"></i>
                        Book Your First Appointment
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Contact Messages -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-envelope me-2"></i>
                My Contact Messages
            </h5>
            <div>
                <span class="badge bg-info text-dark me-2">@(Model.ContactMessages?.Count ?? 0)</span>
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#newMessageModal">
                    <i class="bi bi-plus-circle me-1"></i>
                    Send New Message
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.ContactMessages != null && Model.ContactMessages.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date Sent</th>
                                <th>Subject</th>
                                <th>Message</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model.ContactMessages)
                            {
                                <tr>
                                    <td>@message.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(message.Subject))
                                        {
                                            @message.Subject
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Subject</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(message.Message))
                                        {
                                            <span>@message.Message</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (message.IsRead)
                                        {
                                            <span class="badge bg-success">Read</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Unread</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info text-white"
                                                data-bs-toggle="modal"
                                                data-bs-target="#messageDetailsModal-@message.Id">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>

                                <!-- Message Details Modal -->
                                <div class="modal fade" id="messageDetailsModal-@message.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <h5 class="modal-title">Message Details</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>

                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="fw-semibold">Subject</label>
                                                    <div class="form-control bg-light">
                                                        @if (!string.IsNullOrWhiteSpace(message.Subject))
                                                        {
                                                            @message.Subject
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No Subject</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="fw-semibold">Message</label>
                                                    <div class="form-control bg-light">@message.Message</div>
                                                </div>

                                                <div>
                                                    <label class="fw-semibold">Date Sent</label>
                                                    <div class="text-muted">@message.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</div>
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-envelope-x fs-1 text-muted"></i>
                    <h5 class="mt-3">No Contact Messages</h5>
                    <p class="text-muted">You haven't sent any messages yet.</p>
                    <button type="button" class="btn btn-primary"
                            data-bs-toggle="modal" data-bs-target="#newMessageModal">
                        <i class="bi bi-envelope-plus me-1"></i>
                        Send Your First Message
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Testimonials -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-chat-quote me-2"></i>
                My Testimonials
            </h5>
            <span class="badge bg-warning text-dark">@(Model.Testimonials?.Count ?? 0)</span>
        </div>

        <div class="card-body">

            <!-- Add Testimonial -->
            <div class="border rounded p-4 mb-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-plus-circle me-2"></i>
                    Add Testimonial
                </h5>

                <form asp-controller="Patients" asp-action="AddTestimonial" method="post" novalidate>

                    <!-- Rating -->
                    <div class="mb-3">
                        <label class="form-label d-block fw-semibold">Rating</label>

                        <div class="rating">
                            <input type="radio" name="Rating" value="5" id="rating5" required />
                            <label for="rating5" title="5 stars">★</label>

                            <input type="radio" name="Rating" value="4" id="rating4" />
                            <label for="rating4" title="4 stars">★</label>

                            <input type="radio" name="Rating" value="3" id="rating3" />
                            <label for="rating3" title="3 stars">★</label>

                            <input type="radio" name="Rating" value="2" id="rating2" />
                            <label for="rating2" title="2 stars">★</label>

                            <input type="radio" name="Rating" value="1" id="rating1" />
                            <label for="rating1" title="1 star">★</label>
                        </div>
                    </div>

                    <!-- Message -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message</label>
                        <textarea name="Message" class="form-control" rows="4"
                                  placeholder="Share your experience with our clinic..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Testimonial
                    </button>
                </form>

                <!-- Existing Testimonials -->
                @if (Model.Testimonials != null && Model.Testimonials.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Patient Name</th>
                                    <th>Message</th>
                                    <th>Rating</th>
                                    <th>Visible</th>
                                    <th>Created At</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var testimonial in Model.Testimonials)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(testimonial.ImagePath))
                                                {
                                                    <img src="@testimonial.ImagePath" width="45" height="45"
                                                         class="rounded-circle object-fit-cover me-2"
                                                         alt="@testimonial.PatientName" />
                                                }
                                                <span class="fw-semibold">@testimonial.PatientName</span>
                                            </div>
                                        </td>

                                        <td>@testimonial.Message</td>

                                        <td>
                                            <div class="text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= testimonial.Rating)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star"></i>
                                                    }
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            @if (testimonial.IsVisible)
                                            {
                                                <span class="badge bg-success">Visible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Under Review</span>
                                            }
                                        </td>

                                        <td>@testimonial.CreatedAt.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-chat-square-text fs-1 text-muted"></i>
                        <h5 class="mt-3">No Testimonials</h5>
                        <p class="text-muted mb-0">You haven't submitted any testimonials yet.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- New Contact Message Modal -->
    <div class="modal fade" id="newMessageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-envelope-plus me-2"></i>
                        Send New Message
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form asp-controller="Patients" asp-action="SendMessage" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Subject</label>
                            <input type="text" name="subject" class="form-control" placeholder="Enter subject" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Message</label>
                            <textarea name="message" class="form-control" rows="5"
                                      placeholder="Enter your message..." required></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>
                            Send Message
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
    <style>
            .rating {
                display: inline-flex;
                flex-direction: row-reverse;
                justify-content: flex-end;
                gap: 4px;
            }

                /* Hidden but still keyboard-focusable and validatable */
                .rating input {
                    position: absolute;
                    opacity: 0;
                    width: 0;
                    height: 0;
                }

                .rating label {
                    font-size: 32px;
                    color: #dee2e6;
                    cursor: pointer;
                    transition: color 0.2s ease;
                    line-height: 1;
                }

                    .rating input:checked ~ label,
                    .rating label:hover,
                    .rating label:hover ~ label {
                        color: #ffc107;
                    }

                .rating input:focus-visible + label {
                    outline: 2px solid #0d6efd;
                    outline-offset: 2px;
                }
    </style>