@using ClinicHub.Models.Clinic
@model List<Doctor>
@{
    ViewData["Title"] = "Doctors";
    Layout = "_LayoutAdmin";
}

<!-- Success Message -->
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Doctors</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Doctors</h1>
        <p class="text-secondary mb-0">Manage the clinic's medical team and specialties.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add doctor</a>
</div>

<!-- Search Section -->
<section class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="search" class="form-label">Search</label>
                <input id="search" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Name or email" />
            </div>

            <div class="col-md-4">
                <label for="specialtyId" class="form-label">Specialty</label>
            
                <select id="specialtyId" name="specialtyId" class="form-select">
                    <option value="">All specialties</option>
            
                    @if (ViewBag.Specialties != null)
                    {
                        foreach (var specialty in ViewBag.Specialties)
                        {
                            <option value="@specialty.Id"
                                    selected="@(ViewBag.SpecialtyId?.ToString() == specialty.Id.ToString())">
                                @specialty.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</a>
            </div>
        </form>
    </div>
</section>

<!-- Doctor Directory -->
<section class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Doctor directory</h2>
        <span class="badge text-bg-primary">@(Model?.Count ?? 0)</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Doctor</th>
                    <th>Contact</th>
                    <th>Specialty</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var doctor in Model)
                    {
                        <tr>
                            <!-- Doctor -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(doctor.ImagePath))
                                    {
                                        <img src="@doctor.ImagePath" alt="" class="rounded-circle object-fit-cover"
                                             width="48" height="48" />
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-primary">
                                            @(doctor.User?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                        </span>
                                    }
                                    <div>
                                        <div class="fw-semibold">Dr. @(doctor.User?.FullName ?? "Unknown")</div>
                                        <small class="text-secondary text-truncate d-block"
                                               style="max-width: 280px;"
                                               title="@doctor.Biography">
                                            @(string.IsNullOrWhiteSpace(doctor.Biography) ? "No biography" : doctor.Biography)
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <!-- Contact -->
                            <td>
                                <div>@(doctor.User?.Email ?? "—")</div>
                                <small class="text-secondary">@(doctor.User?.Phone ?? "—")</small>
                            </td>

                            <!-- Specialty -->
                            <td>
                                <span class="badge text-bg-info">@(doctor.Specialty?.Name ?? "General")</span>
                            </td>

                            <!-- Experience -->
                            <td>@(doctor.YearsOfExperience.HasValue ? $"{doctor.YearsOfExperience} years" : "—")</td>

                            <!-- Status -->
                            <td>
                                @if (doctor.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Details</a>
                                    <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
                                    <form asp-action="ToggleStatus" asp-route-id="@doctor.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-person-check me-1"></i> @(doctor.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteDoctorModal-@doctor.Id">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <h3 class="h5">No doctors found</h3>
                            <p class="text-secondary mb-3">Try changing the search or specialty filter.</p>
                            <a asp-action="Create" class="btn btn-primary">Add doctor</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete Doctor Modals -->
@if (Model?.Any() == true)
{
    foreach (var doctor in Model)
    {
        <div class="modal fade" id="deleteDoctorModal-@doctor.Id"
             tabindex="-1"
             aria-labelledby="deleteDoctorLabel-@doctor.Id"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteDoctorLabel-@doctor.Id">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body text-center">
                        <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                        <h5 class="mt-3">Are you sure?</h5>
                        <p class="text-muted mb-3">Are you sure you want to delete this doctor?</p>
                        <div class="fw-semibold">Dr. @(doctor.User?.FullName ?? "Unknown")</div>
                        <div class="text-muted">@(doctor.User?.Email ?? "—")</div>
                        <div class="text-muted">@(doctor.Specialty?.Name ?? "General")</div>
                        <div class="small text-secondary mt-3">
                            Doctors with linked appointments cannot be deleted.
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form asp-controller="Doctors" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@doctor.Id" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Yes, Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}