@using ClinicHub.DTOs.Doctor
@model DoctorCreateDto
@{
    ViewData["Title"] = "Create Doctor";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="container-fluid p-0 min-vh-100 d-flex flex-column">
    <div class="row g-0 flex-grow-1 min-vh-100">

        <!-- Form Column -->
        <div class="col-12 col-lg-7 col-xl-6 d-flex flex-column justify-content-center bg-white p-4 p-sm-5">
            <div class="w-100 mx-auto" style="max-width: 650px;">

                <!-- Header -->
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Create Doctor</h2>
                    <p class="text-muted mb-0">
                        Add a new doctor to the
                        <strong class="text-primary">ClinicHub</strong>
                        system.
                    </p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger alert-dismissible fade show py-2 mb-4 small"
                     role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="row g-3">

                        <!-- Full Name -->
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="FullName" class="form-control bg-light border-start-0"
                                       placeholder="e.g. Ahmad Al-Hassan" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" type="email" class="form-control bg-light border-start-0"
                                       placeholder="dr.ahmad@clinic.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Phone -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary small">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input asp-for="Phone" class="form-control bg-light border-start-0"
                                       maxlength="10" inputmode="numeric" placeholder="07xxxxxxxx" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Specialty -->
                        <div class="col-12 col-md-6">
                            <label asp-for="SpecialtyId" class="form-label fw-semibold text-secondary small">Specialty</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-heart-pulse"></i>
                                </span>
                                <select asp-for="SpecialtyId" asp-items="ViewBag.Specialties"
                                        class="form-select bg-light border-start-0">
                                    <option value="">Select Specialty</option>
                                </select>
                            </div>
                            <span asp-validation-for="SpecialtyId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-shield-lock"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control bg-light border-start-0"
                                       placeholder="Enter password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-start-0"
                                       placeholder="Repeat password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Years Of Experience -->
                        <div class="col-12 col-md-6">
                            <label asp-for="YearsOfExperience" class="form-label fw-semibold text-secondary small">Years of Experience</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-briefcase"></i>
                                </span>
                                <input asp-for="YearsOfExperience" type="number" min="0"
                                       class="form-control bg-light border-start-0" placeholder="e.g. 5" />
                            </div>
                            <span asp-validation-for="YearsOfExperience" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Profile Image -->
                        <div class="col-12">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-secondary small">Profile Image</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-image"></i>
                                </span>
                                <input asp-for="ImageFile" type="file" class="form-control bg-light border-start-0"
                                       accept="image/*" />
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Biography -->
                        <div class="col-12">
                            <label asp-for="Biography" class="form-label fw-semibold text-secondary small">Biography</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted align-items-start pt-3">
                                    <i class="bi bi-file-person"></i>
                                </span>
                                <textarea asp-for="Biography" class="form-control bg-light border-start-0" rows="4"
                                          placeholder="Write a short biography about the doctor..."></textarea>
                            </div>
                            <span asp-validation-for="Biography" class="text-danger small mt-1 d-block"></span>
                        </div>

                    </div>

                    <!-- Submit -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Create Doctor
                        </button>
                    </div>

                    <!-- Back -->
                    <div class="text-center mt-3">
                        <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Doctors
                        </a>
                    </div>
                </form>

            </div>
        </div>

        <!-- Image / Branding Column -->
        <div class="col-lg-5 col-xl-6 d-none d-lg-block position-relative p-0 overflow-hidden">
            <img src="~/assets/img/Create/doctors.jpg" alt="Clinic Staff"
                 class="w-100 h-100 object-fit-cover position-absolute top-0 start-0" />

            <div class="position-absolute top-0 start-0 w-100 h-100 auth-hero-overlay d-flex flex-column justify-content-between p-5 text-white">

                <!-- Badge -->
                <div class="d-flex align-items-center">
                    <span class="badge bg-white bg-opacity-25 px-3 py-2 rounded-pill fs-6 fw-normal text-white border border-white border-opacity-25">
                        <i class="bi bi-heart-pulse me-1"></i>
                        ClinicHub Healthcare System
                    </span>
                </div>

                <!-- Content -->
                <div class="mb-4">
                    <h1 class="display-6 fw-bold mb-3">Add a New Doctor.</h1>
                    <p class="lead opacity-90 mb-4 fs-6">
                        Add qualified doctors to ClinicHub and provide patients
                        with easy access to medical specialists and appointments.
                    </p>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-info"></i>
                            <span class="small">Create a complete doctor profile</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-info"></i>
                            <span class="small">Assign the appropriate medical specialty</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-info"></i>
                            <span class="small">Manage appointments and doctor schedules</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>