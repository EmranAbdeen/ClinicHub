@model ClinicHub.DTOs.Doctor.DoctorProfile.DoctorProfileDto
@using ClinicHub.Models.Enums
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_Layout";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Doctor profile</h1>
            <p class="text-secondary mb-0">Manage your professional information, availability, and appointments.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
            <a asp-controller="DoctorSchedules" asp-action="Index" class="btn btn-outline-primary">Manage Schedule</a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-@(TempData["SuccessType"] ?? "success")">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Doctor Profile -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">

                <!-- Profile Image -->
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" width="180" height="180"
                             class="rounded-circle object-fit-cover mb-3" alt="Doctor Profile Image" />
                    }
                    else
                    {
                        <span class="badge rounded-circle text-bg-primary fs-1 p-4 mb-3">
                            @(Model.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                        </span>
                    }

                    <h4 class="mb-1">Dr. @Model.FullName</h4>
                    <p class="text-muted">@Model.SpecialtyName</p>
                </div>

                <!-- Doctor Information -->
                <div class="col-md-8">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted">Full Name</label>
                            <div class="fw-semibold">@Model.FullName</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="text-muted">Email</label>
                            <div class="fw-semibold text-break">
                                @(string.IsNullOrWhiteSpace(Model.Email) ? "Not provided" : Model.Email)
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="text-muted">Phone</label>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="text-muted">Specialty</label>
                            <div class="fw-semibold">@Model.SpecialtyName</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="text-muted">Years of Experience</label>
                            <div class="fw-semibold">
                                @(Model.YearsOfExperience.HasValue
                                    ? Model.YearsOfExperience + " Years"
                                    : "—")
                            </div>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="text-muted">Biography</label>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Biography)
                                    ? "No biography available."
                                    : Model.Biography)
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Available Schedules -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Available Schedules</h5>
                <a asp-controller="DoctorSchedules" asp-action="Create" class="btn btn-success btn-sm">+ Add Schedule</a>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.Schedules != null && Model.Schedules.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Slot</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.Schedules)
                            {
                                <tr>
                                    <td>@schedule.AvailableDate.ToString("dd MMM yyyy")</td>
                                    <td>@schedule.StartTime.ToString("HH:mm")</td>
                                    <td>@schedule.EndTime.ToString("HH:mm")</td>
                                    <td>@schedule.SlotMinutes min</td>
                                    <td class="text-center">
                                        <a asp-controller="DoctorSchedules" asp-action="Edit"
                                           asp-route-id="@schedule.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mt-2 mb-0">No schedules available.</p>
                </div>
            }
        </div>
    </div>

    <!-- Patient Appointments -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-calendar-check me-2"></i>
                Patient Appointments
            </h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Notes</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                var badgeClass = appointment.Status switch
                                {
                                    AppointmentStatus.Pending   => "bg-warning text-dark",
                                    AppointmentStatus.Confirmed => "bg-primary",
                                    AppointmentStatus.Completed => "bg-success",
                                    AppointmentStatus.Cancelled => "bg-danger",
                                    AppointmentStatus.Rejected  => "bg-danger",
                                    _                           => "bg-secondary"
                                };

                                var statusText = appointment.Status switch
                                {
                                    AppointmentStatus.Pending   => "Pending",
                                    AppointmentStatus.Confirmed => "Confirmed",
                                    AppointmentStatus.Completed => "Completed",
                                    AppointmentStatus.Cancelled => "Cancelled",
                                    AppointmentStatus.Rejected  => "Rejected",
                                    _                           => "Unknown"
                                };

                                <tr>
                                    <td><span class="fw-semibold">@appointment.PatientName</span></td>
                                    <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@appointment.AppointmentTime.ToString("HH:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(appointment.Notes) ? "—" : appointment.Notes)</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@statusText</span>
                                    </td>

                                    <!-- Action -->
                                    <td class="text-center">
                                        @if (appointment.Status == AppointmentStatus.Pending)
                                        {
                                            <!-- Accept -->
                                            <form asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="status" value="@AppointmentStatus.Confirmed" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Doctors")" />
                                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                            </form>

                                            <!-- Reject -->
                                            <form asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="status" value="@AppointmentStatus.Rejected" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Doctors")" />
                                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                            </form>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Confirmed)
                                        {
                                            <!-- Complete -->
                                            <form asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="status" value="@AppointmentStatus.Completed" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Doctors")" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Complete
                                                </button>
                                            </form>

                                            <!-- Cancel -->
                                            <form asp-controller="Appointments" asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="status" value="@AppointmentStatus.Cancelled" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Doctors")" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Completed ||
                                                 appointment.Status == AppointmentStatus.Rejected ||
                                                 appointment.Status == AppointmentStatus.Cancelled)
                                        {
                                            <!-- Delete Button -->
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteAppointmentModal-@appointment.Id">
                                                Delete
                                            </button>

                                            <!-- Delete Confirmation Modal -->
                                            <div class="modal fade" id="deleteAppointmentModal-@appointment.Id"
                                                 tabindex="-1"
                                                 aria-labelledby="deleteAppointmentLabel-@appointment.Id"
                                                 aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">

                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="deleteAppointmentLabel-@appointment.Id">Confirm Delete</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>

                                                        <div class="modal-body text-center">
                                                            <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                                                            <h5 class="mt-3">Are you sure?</h5>
                                                            <p class="text-muted">Are you sure you want to delete this appointment?</p>
                                                            <div class="fw-semibold">Patient: @appointment.PatientName</div>
                                                            <div class="text-muted">
                                                                @appointment.AppointmentDate.ToString("dd MMM yyyy")
                                                                -
                                                                @appointment.AppointmentTime.ToString("HH:mm")
                                                            </div>
                                                        </div>

                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-controller="Appointments" asp-action="Delete" method="post" class="d-inline">
                                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                                <input type="hidden" name="returnUrl" value="@Url.Action("Profile", "Doctors")" />
                                                                <button type="submit" class="btn btn-danger">
                                                                    <i class="bi bi-trash me-1"></i>
                                                                    Yes, Delete
                                                                </button>
                                                            </form>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h6 class="mt-3 text-muted">No appointments found.</h6>
                    <p class="text-muted mb-0">You don't have any patient appointments yet.</p>
                </div>
            }
        </div>
    </div>

</div>