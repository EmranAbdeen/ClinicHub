@using ClinicHub.DTOs.Doctor
@model DoctorDetailsDto
@{
    var role = Context.Session.GetString("UserRole");
    bool isAdmin = role == "Admin" || role == "Super_admin";

    ViewData["Title"] = $"Dr. {Model.FullName}";
    Layout = isAdmin ? "_LayoutAdmin" : "_Layout";
}

<div class="container-fluid p-3">

    <!-- Breadcrumb -->
    @if (isAdmin)
    {
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="text-decoration-none">Doctors</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Doctor Details</li>
            </ol>
        </nav>
    }

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Doctor Profile</h1>
            <p class="text-secondary mb-0">Contact and professional details for Dr. @Model.FullName.</p>
        </div>

        @if (isAdmin)
        {
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>
                    Edit Doctor
                </a>
            </div>
        }
    </div>

    <!-- Doctor Details -->
    <div class="row g-4">

        <!-- Doctor Profile Card -->
        <div class="col-lg-4">
            <section class="card h-100">
                <div class="card-body text-center">

                    <!-- Doctor Image -->
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="Dr. @Model.FullName"
                             class="rounded-circle object-fit-cover mb-3" width="150" height="150" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 150px; height: 150px;">
                            <span class="display-3">
                                @(Model.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </span>
                        </div>
                    }

                    <!-- Doctor Name -->
                    <h2 class="h4 mb-2">Dr. @Model.FullName</h2>

                    <!-- Specialty -->
                    <p class="mb-3">
                        <span class="badge text-bg-info">@(Model.SpecialtyName ?? "General Practice")</span>
                    </p>

                    <!-- Account Status -->
                    @if (Model.IsActive)
                    {
                        <span class="badge text-bg-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">
                            <i class="bi bi-pause-circle me-1"></i>
                            Inactive
                        </span>
                    }

                    <hr class="my-4" />

                    <!-- Clinical Experience -->
                    <div class="text-secondary small mt-3">Clinical Experience</div>
                    <div class="h3 fw-semibold text-primary mb-1">
                        @(Model.YearsOfExperience.HasValue
                            ? $"{Model.YearsOfExperience} years"
                            : "Not specified")
                    </div>
                    <p class="text-secondary small mb-0">Years of professional experience</p>
                </div>
            </section>
        </div>

        <!-- Contact and Professional Details -->
        <div class="col-lg-8">
            <section class="card h-100">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 mb-0">
                        <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                        Contact and Professional Details
                    </h2>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-0">

                        <!-- Email -->
                        <dt class="col-sm-4 mb-2">
                            <i class="bi bi-envelope me-2 text-secondary"></i>
                            Email Address
                        </dt>
                        <dd class="col-sm-8 mb-4 text-break">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-secondary">Not provided</span>
                            }
                        </dd>

                        <!-- Phone -->
                        <dt class="col-sm-4 mb-2">
                            <i class="bi bi-telephone me-2 text-secondary"></i>
                            Phone Number
                        </dt>
                        <dd class="col-sm-8 mb-4">
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                            }
                            else
                            {
                                <span class="text-secondary">Not provided</span>
                            }
                        </dd>

                        <!-- Specialty -->
                        <dt class="col-sm-4 mb-2">
                            <i class="bi bi-heart-pulse me-2 text-secondary"></i>
                            Specialty
                        </dt>
                        <dd class="col-sm-8 mb-4">@(Model.SpecialtyName)</dd>

                        <!-- Registration Date -->
                        <dt class="col-sm-4 mb-2">
                            <i class="bi bi-calendar-check me-2 text-secondary"></i>
                            Registration Date
                        </dt>
                        <dd class="col-sm-8 mb-4">@Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")</dd>

                        <!-- Biography -->
                        <dt class="col-sm-4 mb-2">
                            <i class="bi bi-file-text me-2 text-secondary"></i>
                            Biography
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Biography))
                            {
                                <p class="mb-0 text-break" style="white-space: pre-line;">@Model.Biography</p>
                            }
                            else
                            {
                                <span class="text-secondary">No biography provided.</span>
                            }
                        </dd>

                    </dl>
                </div>
            </section>
        </div>

    </div>
</div>