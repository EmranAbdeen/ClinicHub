@model List<ClinicHub.Models.Content.Testimonial>
@{
    ViewData["Title"] = "Testimonials";
    Layout = "_LayoutAdmin";
}

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Testimonials</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Testimonials</h1>
        <p class="text-secondary mb-0">Manage patient feedback shown on the clinic website.</p>
    </div>
</div>

<section class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Patient feedback</h2>
        <span class="badge text-bg-primary">@Model.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Patient</th>
                    <th>Message</th>
                    <th>Rating</th>
                    <th>Visibility</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var testimonial in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@testimonial.PatientName</td>
                            <td>@testimonial.Message</td>
                            <td>
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= testimonial.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @if (testimonial.IsVisible)
                                {
                                    <span class="badge text-bg-success">Visible</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Hidden</span>
                                }
                            </td>
                            <td>@testimonial.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-1">
                                    <a asp-action="Details" asp-route-id="@testimonial.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    <form asp-action="ToggleVisibility" asp-route-id="@testimonial.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(testimonial.IsVisible ? "Hide" : "Show")
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteTestimonialModal-@testimonial.Id">
                                        Delete
                                    </button>
                                </div>

                                <div class="modal fade" id="deleteTestimonialModal-@testimonial.Id" tabindex="-1"
                                     aria-labelledby="deleteTestimonialLabel-@testimonial.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="deleteTestimonialLabel-@testimonial.Id">Delete testimonial</h2>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Delete the testimonial from <strong>@testimonial.PatientName</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" method="post">
                                                    <input type="hidden" name="id" value="@testimonial.Id" />
                                                    <button type="submit" class="btn btn-danger">Delete testimonial</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <h3 class="h5">No testimonials yet</h3>
                            <p class="text-secondary mb-3">Add patient feedback to feature on the website.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>