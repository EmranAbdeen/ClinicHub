@using ClinicHub.Models.Clinic
@model List<User>
@{
    ViewData["Title"] = "Admins";
    Layout = "_LayoutAdmin";
}

<!-- Success Message -->
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Admins</li>
            </ol>
        </nav>
        <h1 class="h3 mb-1">Administrators</h1>
        <p class="text-secondary mb-0">Manage system administrator accounts.</p>
    </div>

    <a asp-controller="Account" asp-action="CreateAdmin" class="btn btn-danger">
        <i class="bi bi-person-plus me-1"></i>
        Add Admin
    </a>
</div>

<!-- Search Section -->
<section class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label for="search" class="form-label">Search Administrators</label>
                <input type="text" id="search" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Search by name, email, or phone" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>
                    Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset
                </a>
            </div>
        </form>
    </div>
</section>

<!-- Admin Directory -->
<section class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0">Admin Directory</h2>
        <span class="badge text-bg-primary">@(Model?.Count ?? 0)</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Administrator</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    foreach (var admin in Model)
                    {
                        <tr>
                            <!-- Administrator Information -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                          style="width: 45px; height: 45px;">
                                        @(admin.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                    </span>
                                    <span class="fw-semibold">@admin.FullName</span>
                                </div>
                            </td>

                            <!-- Contact Information -->
                            <td>
                                <div>@admin.Email</div>
                                <small class="text-secondary">@(admin.Phone ?? "—")</small>
                            </td>

                            <!-- Account Status -->
                            <td>
                                @if (admin.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>

                            <!-- Creation Date -->
                            <td>@admin.CreatedAt.ToString("dd MMM yyyy")</td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a asp-action="Details" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil me-1"></i>
                                        Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteAdminModal-@admin.Id">
                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteAdminModal-@admin.Id" tabindex="-1"
                                     aria-labelledby="deleteAdminLabel-@admin.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="deleteAdminLabel-@admin.Id">Delete Administrator</h2>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                Are you sure you want to delete the administrator account for
                                                <strong>@admin.FullName</strong>?
                                                <p class="text-secondary small mb-0 mt-2">This action cannot be undone.</p>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" method="post">
                                                    <input type="hidden" name="id" value="@admin.Id" />
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete Admin
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Empty State -->
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-people text-secondary fs-1 d-block mb-3"></i>
                            <h3 class="h5">No Administrators Found</h3>
                            <p class="text-secondary mb-3">No administrators match your search.</p>
                            <a asp-controller="Account" asp-action="CreateAdmin" class="btn btn-primary">
                                <i class="bi bi-person-plus me-1"></i>
                                Add Admin
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Table Footer -->
    <div class="card-footer bg-white text-secondary small">
        Showing @(Model?.Count ?? 0) administrator(s)
    </div>
</section>