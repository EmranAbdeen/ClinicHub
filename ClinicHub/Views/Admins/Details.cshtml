@using ClinicHub.Models.Clinic
@model User
@{
    ViewData["Title"] = "Admin Details";
    Layout = "_LayoutAdmin";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="Index" class="text-decoration-none">Admins</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Details</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Administrator profile</h1>
        <p class="text-secondary mb-0">Account and access information for @Model.FullName.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to admins</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit admin</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="card h-100">
            <div class="card-body text-center">
                <span class="badge rounded-pill text-bg-primary fs-2 mb-3">@Model.FullName?.FirstOrDefault()</span>
                <h2 class="h4">@Model.FullName</h2>
                <span class="badge text-bg-primary">@(Model.Role?.Name ?? "Admin")</span>
            </div>
        </section>
    </div>

    <div class="col-lg-8">
        <section class="card">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Account details</h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Full name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8 text-break">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</dd>

                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8">@(Model.Role?.Name ?? "Admin")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm tt")</dd>
                </dl>
            </div>
        </section>
    </div>
</div>